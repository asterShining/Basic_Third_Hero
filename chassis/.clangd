CompileFlags:
  Remove:
    - "mthumb-interwork"
    - "Wunused-variable"

  Add:
    - "-isystem/usr/lib/gcc/arm-none-eabi/10.3.1/include"
    - "-isystem/usr/lib/gcc/arm-none-eabi/10.3.1/include-fixed"
    - "-isystem/usr/lib/gcc/arm-none-eabi/10.3.1/../../../arm-none-eabi/include"
Diagnostics:
  UnusedIncludes: None
  Suppress:
    - "-Wunused-variable"
